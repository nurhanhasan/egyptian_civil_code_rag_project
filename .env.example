# Environment template.
# Copy before running:  cp .env.example .env.dev
# This file is committed. NEVER put real credentials here — leave the SECRET
# slots blank and set them in .env.dev / your secret store.
#
# Mirrors the development environment (.env.dev: BGE-M3 embedder, BGE reranker,
# Qdrant retriever, OpenAI-compatible generator).

# Application
APP_DEBUG=true
APP_NAME=RAGApp
ENVIRONMENT=dev
LOGGING_LEVEL=INFO
CACHE_NAMESPACE=ragapp:cache
CACHE_TTL=60
# Dev-only permissive CORS. Restrict this for any non-local deployment.
CORS_ORIGINS='["*"]'

# Cache / broker / result / rate-limit Redis databases
REDIS_CACHE_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND_URL=redis://localhost:6379/2
REDIS_RATELIMIT_URL=redis://localhost:6379/3
REDIS_URL=redis://localhost:6379/0

# LLM Generator — OpenAI-compatible (vLLM, Ollama, etc.)
# SECRET: leave blank here.
OPENAI_API_KEY=
GENERATOR_BACKEND=openai
# Leave unset to use the default in core/config.py. An empty value overrides
# that default with "" — pydantic-settings treats it as an explicit value.
# GENERATOR_SYSTEM_PROMPT=...
# macOS: keep vLLM on the host (vllm-metal / MLX) and point here.
#   local API  -> http://localhost:7080/v1
#   Docker API -> http://host.docker.internal:7080/v1
# .env.dev runs rag-api inside docker-compose, so it uses host.docker.internal.
OPENAI_BASE_URL=http://host.docker.internal:7080/v1
# SECRET: leave blank here.
OPENAI_API_KEY=
GENERATOR_MODEL=Qwen/Qwen3-0.6B
VLLM_SERVED_MODEL_NAME=Qwen/Qwen3-0.6B
GENERATOR_TEMPERATURE=0.0
GENERATOR_MAX_TOKENS=1000
GENERATOR_TIMEOUT=120.0

# Embedder / Reranker device.
# Unset = auto (CUDA > MPS > CPU). "cpu" is for macOS local dev, where
# concurrent MPS access trips a Metal assertion. Leave unset for GPU Docker.
BGE_DEVICE=cpu

# Embedder — BGE-M3 (GPU recommended)
EMBEDDER_BACKEND=bge
EMBEDDER_MODEL_ID=BAAI/bge-m3
EMBEDDER_MODEL_REVISION_ID=5617a9f61b028005a4858fdac845db406aefb181
# Model paths - use HF model IDs (downloads cached in HF cache volume)
BGE_M3_MODEL_PATH=BAAI/bge-m3

# Reranker — BGE reranker (GPU recommended)
RERANKER_BACKEND=bge
BGE_RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION_ID=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e

# Retriever — Qdrant (reads alias)
RETRIEVER_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_ALIAS=egyptian-civil-code
QDRANT_TIMEOUT=5.0

# HF cache configuration (container paths)
HF_HOME=/home/app/.cache/huggingface
TRANSFORMERS_CACHE=/home/app/.cache/huggingface/hub
HF_CACHE_PATH=/home/app/.cache/huggingface/hub

# rag-api/rag-api-canary use the `hf-cache` named Docker volume at the
# container path above. The image creates it as the `app` user, so no host
# UID/GID alignment is needed. The first start downloads BGE-M3 (~2.2 GB);
# later starts reuse the volume. `docker compose down -v` deletes it.
#
# HF_HUB_DIR is a COMPOSE-TIME variable used by the vLLM services, which
# bind-mount the host cache (they run as root, so they can write to it). For it
# to affect the volume source it must be exported in your shell or set in a
# root `.env` (compose's own env file), NOT in this file. Do not use `~`.
# HF_HUB_DIR=/Users/you/.cache/huggingface/hub
# HF_HUB_OFFLINE=1   # set to 1 to forbid any network access to the HF Hub

# IMPORTANT: Docker Desktop memory limit must be >= 4GB (8GB recommended)
# because BGE-M3 model (~2.2GB) uses mmap loading which requires contiguous
# virtual memory. On Mac: Docker Desktop > Settings > Resources > Memory > 8GB.

# Rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PERIOD=60
RATE_LIMIT_BUCKET_TTL=120

# Redis
REDIS_CACHE_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND_URL=redis://localhost:6379/2
REDIS_RATELIMIT_URL=redis://localhost:6379/3
REDIS_URL=redis://localhost:6379/0

# Static API key (disabled by default).
# SECRET: leave blank here; set a strong value in non-local environments.
API_KEY_ENABLED=false
API_KEY=

# Evaluation
MLFLOW_TRACKING_URI=http://localhost:5000

# Langfuse — required by Settings; keys are SECRET, leave blank here.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# vLLM container (`docker compose --profile gpu up -d`). Pin VLLM_IMAGE by digest.
# VLLM_IMAGE=vllm/vllm-openai:v0.31.0
# VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ
# VLLM_MAX_MODEL_LEN=8192
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# VLLM_LOGGING_LEVEL=INFO

# CPU-only vLLM (`docker compose --profile cpu up -d`) — no GPU needed.
# AWQ kernels are GPU-only, so this uses the unquantized model.
# VLLM_CPU_IMAGE=vllm/vllm-openai-cpu:v0.31.0
# VLLM_CPU_MODEL=Qwen/Qwen2.5-3B-Instruct
# VLLM_CPU_MAX_MODEL_LEN=4096
# VLLM_CPU_KVCACHE_SPACE=4
