# Environment template.
# Copy before running:  mv .env.example .env.dev
# This file is committed. NEVER put real credentials here — leave the SECRET
# slots blank and set them in .env.dev / your secret store.


# Application
APP_DEBUG=true
APP_NAME=RAGApp
ENVIRONMENT=dev
LOGGING_LEVEL=INFO
CACHE_NAMESPACE=ragapp:cache
CACHE_TTL=60
# Dev-only permissive CORS. Restrict this for any non-local deployment.
CORS_ORIGINS='["*"]'

# LLM Generator - OpenAI-compatible (vLLM, Ollama, etc.)
GENERATOR_BACKEND=openai
# Leave unset to use the default in core/config.py.
# GENERATOR_SYSTEM_PROMPT=...
OPENAI_BASE_URL=http://localhost:7080/v1
# OPENAI_BASE_URL=http://host.docker.internal:7080/v1
OPENAI_API_KEY=
# GENERATOR_MODEL=prism-ml/Bonsai-27B-mlx-1bit
# GENERATOR_MODEL=qwen3.8-27b-8bit
# GENERATOR_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ
# GENERATOR_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# GENERATOR_MODEL=google/gemma-3-1b-it
GENERATOR_MODEL=Qwen/Qwen3-0.6B
VLLM_SERVED_MODEL_NAME=Qwen/Qwen3-0.6B
GENERATOR_TEMPERATURE=0.0

# `--max-model-len` 8192    Total window: prompt tokens + completion tokens
# `--max-model-len` = prompt_tokens (inputs(system prompt + user prompt (question + context))) + max_tokens (output/completion/response)
# For vllm or vllm-cpu, VLLM_CPU_MAX_MODEL_LEN or VLLM_MAX_MODEL_LEN is equvilant to `--max-model-len` passed through serve command from root .env file
VLLM_CPU_MAX_MODEL_LEN=8192
VLLM_MAX_MODEL_LEN=8192

# GENERATOR_MAX_TOKENS is the completion/response tokens
# `GENERATOR_MAX_TOKENS` the completion budget and must never equal `--max-model-len`.
# `GENERATOR_MAX_TOKENS` is equivelant to max_tokens parameter passed to AsyncOpenAI
GENERATOR_MAX_TOKENS=2000

GENERATOR_TIMEOUT=120.0

BGE_DEVICE=cpu

# Embedder - BGE-M3 via BentoML (GPU recommended)
EMBEDDER_BACKEND=bge
EMBEDDER_MODEL_ID=BAAI/bge-m3
EMBEDDER_MODEL_REVISION_ID=5617a9f61b028005a4858fdac845db406aefb181
# Model paths - use HF model IDs (downloads cached in HF cache volume)
BGE_M3_MODEL_PATH=BAAI/bge-m3

# Reranker - BGE reranker via BentoML (GPU recommended)
RERANKER_BACKEND=bge
BGE_RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION_ID=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e

# Retriever - Qdrant (reads alias)
RETRIEVER_BACKEND=qdrant
# RETRIEVER_BACKEND=bge
QDRANT_URL=http://localhost:6333
# In-process Qdrant local mode (no server); set by the API image to /app/qdrant_storage.
QDRANT_RETRIEVER_PATH=qdrant_storage
QDRANT_COLLECTION_ALIAS=egyptian-civil-code
QDRANT_TIMEOUT=5.0


# HF Cache configuration
HF_HOME=/home/app/.cache/huggingface
TRANSFORMERS_CACHE=/home/app/.cache/huggingface/hub
HF_CACHE_PATH=/home/app/.cache/huggingface/hub

# IMPORTANT: Docker Desktop memory limit must be >= 4GB (8GB recommended)
# because BGE-M3 model (~2.2GB) uses mmap loading which requires
# contiguous virtual memory. In Docker Desktop settings, set memory to 8GB+.
# On Mac: Docker Desktop > Settings > Resources > Advanced > Memory > 8GB

# Rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PERIOD=60
RATE_LIMIT_BUCKET_TTL=120

# Redis
REDIS_CACHE_URL=redis://localhost:6400/0
CELERY_BROKER_URL=redis://localhost:6400/1
CELERY_RESULT_BACKEND_URL=redis://localhost:6400/2
REDIS_RATELIMIT_URL=redis://localhost:6400/3
REDIS_URL=redis://localhost:6400/0

# API Key (disabled by default)
API_KEY_ENABLED=false
API_KEY=


# Evaluation
MLFLOW_TRACKING_URI=http://localhost:5000

# RAGAS
JUDGE_BASE_LLM=http://localhost:8000/v1
JUDGE_MODEL=qwen3.8-27b-8bit

# Langfuse
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="http://localhost:3000"