# Application
APP_DEBUG=true
APP_NAME=RAGApp
ENVIRONMENT=dev

# Logging
LOGGING_LEVEL=DEBUG

# Cache settings
REDIS_CACHE_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND_URL=redis://localhost:6379/2
REDIS_RATELIMIT_URL=redis://localhost:6379/3
REDIS_URL=redis://localhost:6379/0
CACHE_NAMESPACE=ragapp:cache
CACHE_TTL=60

# CORS
CORS_ORIGINS=[""]

# Static API key. Off by default in local dev.
API_KEY=
API_KEY_ENABLED=false

# Rate limiting 
RATE_LIMIT_ENABLED=false
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PERIOD=60
RATE_LIMIT_BUCKET_TTL=120

# Generator Settings
GENERATOR_BACKEND=openai
OPENAI_BASE_URL=http://localhost:7080/v1
GENERATOR_MODEL=qwen3.8-27b-8bit
# GENERATOR_SYSTEM_PROMPT=""
# GENERATOR_TEMPERATURE=0.0
# GENERATOR_MAX_TOKENS=512
# GENERATOR_TIMEOUT=120.0
