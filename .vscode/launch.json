{
  "version": "0.2.0",
  "configurations": [
    {
        "name": "Python: Current File",
        "type": "python",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal",
        "justMyCode": true
    },
    {
      "name": "App",
      "type": "debugpy",
      "request": "launch",
      // "module": "uvicorn",
      "program": "./.venv/bin/uvicorn",
      "args": [
        "ragapp.entrypoints.fastapi.main:app",
        "--reload",
        "--no-access-log",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env.dev",
      "env": {
        "HF_HOME": "${env:HOME}/.cache/huggingface",
        "TRANSFORMERS_CACHE": "${env:HOME}/.cache/huggingface/hub",
        "HF_CACHE_PATH": "${env:HOME}/.cache/huggingface/hub"
      },
      "jinja": false,
      "justMyCode": true,
      "postDebugTask": "killdebugger"
    },
    {
      "name": "Ragas",
      "type": "debugpy",
      "request": "launch",
      "module": "ragapp.scripts.ragas",
      "args": [
        "--gold",
        "data/gold/gold_set.json",
        // "--judge-model",
        // "qwen3.8-27b-8bit",
        "--with-embeddings",
        // "--base-url",
        // "http://localhost:7080/v1",
        "--strict",
        // "--no-think"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env.dev",
      "env": {
        "HF_HOME": "${env:HOME}/.cache/huggingface",
        "TRANSFORMERS_CACHE": "${env:HOME}/.cache/huggingface/hub",
        "HF_CACHE_PATH": "${env:HOME}/.cache/huggingface/hub"
      },
      "jinja": false,
      "justMyCode": true,
      "postDebugTask": "killdebugger"
    }
  ]
}
