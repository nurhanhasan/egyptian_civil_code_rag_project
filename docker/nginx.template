# nginx configuration for canary deployment

# Use Docker's internal DNS resolver for dynamic service discovery
resolver 127.0.0.11 valid=10s ipv6=off;

# Split clients for percentage-based canary routing
# Default: 90% stable, 10% canary
# Adjust $canary_percentage to change traffic split (e.g., 0.10 = 10%)
# Split with consistent-hash on client IP Address
# # split_clients "${remote_addr}${http_user_agent}" $upstream_variant {
# #    50%     "canary";
# #    *       "stable";
# #}

# Split all requests
split_clients "$request_id" $upstream_variant {
    50%     "canary";
    *       "stable";
}

# Map variant to actual upstream server
map $upstream_variant $upstream_server {
    "canary"  "rag-api-canary:8000";
    "stable"  "rag-api:8000";
    default   "rag-api:8000";
}

server {
    listen ${PORT};
    server_name ${SERVER_NAME};

    # API endpoints - route via split_clients for canary
    location ^~ /api/v1/ {
        # Use the mapped upstream server
        proxy_pass http://$upstream_server;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Upstream-Variant $upstream_variant;

        add_header       X-Upstream-Variant $upstream_variant always;    # response → client
        
        # Timeouts
        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 90s;
        
        # Buffering
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        
        # Fallback to stable if canary fails (502/503/504)
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
    }

    # # SSE streaming endpoint - disable buffering for streaming
    # location /api/v1/ask/stream {
    #     proxy_pass http://$upstream_server;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    #     proxy_set_header X-Upstream-Variant $upstream_variant;
        
    #     # Critical for SSE: disable buffering
    #     proxy_buffering off;
    #     proxy_cache off;
    #     proxy_http_version 1.1;
    #     proxy_set_header Connection "";
        
    #     # Long timeouts for streaming
    #     proxy_connect_timeout 30s;
    #     proxy_send_timeout 300s;
    #     proxy_read_timeout 300s;
        
    #     proxy_next_upstream error timeout http_502 http_503 http_504;
    #     proxy_next_upstream_tries 2;
    # }

    # Default: proxy all other traffic to stable -- Fallback
    location / {
        proxy_pass http://rag-api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header X-Upstream-Variant stable always;    # response → client
        
        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 90s;
    }
}